{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "culinari-algorithm-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-21",
  "compatibility_flags": ["nodejs_compat"],
  "ai": {
    "binding": "AI"
  },
  "routes": [
    {
      "pattern": "algo.theculinari.com",
      "custom_domain": true
    }
  ]
}
